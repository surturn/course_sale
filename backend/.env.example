# Application
PROJECT_NAME=Invonics Technologies Storefront

# Database
DATABASE_URL=postgresql+asyncpg://invonics:invonics_dev_pass@localhost:5433/invonics_dev

# JWT
SECRET_KEY=changeme_generate_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=invonics_minio
MINIO_SECRET_KEY=invonics_minio_pass
MINIO_BUCKET_NAME=invonics-resources
MINIO_SECURE=false

# Brevo (Email)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@invonics.com
BREVO_SENDER_NAME=Invonics Technologies

# M-Pesa Daraja
DARAJA_ENV=mock
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
DARAJA_SHORTCODE=your_shortcode
DARAJA_PASSKEY=your_passkey
DARAJA_CALLBACK_URL=https://your-staging-url.com/api/v1/payments/callback

# Security
REBIND_LIMIT_PER_MONTH=3
WATERMARK_TTL_HOURS=4
OTP_EXPIRE_MINUTES=10
